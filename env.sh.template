#!/bin/sh
# Usage: copy this file to env.sh and fill in your values.
#        ./entrypoint.sh sources it automatically and runs both K6 and
#        Lighthouse phases.

export CI=false
export ENVIRONMENT=perf-test

# CDP Portal Profile equivalent. Selects the workload; ENVIRONMENT only
# selects the target hosts. Also supports unsubmitted and unsubmitted-journey.
export PROFILE=all

# Polling profiles use 500 TOTAL initial organisations, then capped growth.
# They ignore TEST_SCENARIO and run the dedicated polling K6 script.
# unsubmitted-journey additionally runs baseline + repeated A/B API rounds
# from stub initialisation through the existing polling/browser session.
# export LOAD_TEST_USER_COUNT=500
# export LOAD_TEST_CSO_PERCENTAGE=75
# export LOAD_TEST_REGISTRATION_YEARS=2025,2026,2027,2028,2029,2030
# export LOAD_TEST_OBLIGATION_YEAR=2026
# export LOAD_TEST_ORGANISATION_GROWTH_INTERVAL_SECONDS=1800
# export LOAD_TEST_OBLIGATION_CHANGE_INTERVAL_SECONDS=1800
# export LOAD_TEST_MAX_ADDITIONAL_ORGANISATIONS=288
# Readiness/duration derive from the actual service configuration by default.
# These expectations assert the deployed values; they do not change the service.
# export LOAD_TEST_STALENESS_SECONDS=1800
# export LOAD_TEST_EXPECTED_ORGANISATION_POLL_INTERVAL_SECONDS=1800
# export LOAD_TEST_EXPECTED_OBLIGATION_REFRESH_INTERVAL_SECONDS=1800
# export LOAD_TEST_POLL_CYCLES=2
# export LOAD_TEST_POLL_DURATION=60m
# Only an explicit local smoke run may be shorter than the derived windows.
# export LOAD_TEST_ALLOW_SHORT_SMOKE=true
# Local API wiring checks only. CDP release runs use the default 3m/5m windows.
# export LOAD_TEST_API_SCENARIO_A_DURATION=30s
# export LOAD_TEST_API_SCENARIO_B_DURATION=30s
# export LOAD_TEST_POLL_RATE_PER_MINUTE=60
# export LOAD_TEST_JOURNEY_RATE_PER_MINUTE=1
# export LOAD_TEST_JOURNEY_CONCURRENCY=4
# Combined starts at the first visible original target-year ID, then discovers
# more original IDs every five seconds. Successful submit/cancel cycles reuse IDs.
# Optional total cycle cap; default unlimited during the fixed measured window.
# LOAD_TEST_BROWSER_SAMPLE_COUNT is a legacy alias for this cap.
# LOAD_TEST_ACCEPT_PERCENTAGE is obsolete; combined journeys always cancel.
# export LOAD_TEST_JOURNEY_LIMIT=60

# Azure stub control API. Every profile acquires an exclusive run lease before
# starting, preventing separate tasks from sharing target data or allocations.
export EPR_AZURE_STUB_BASE_URL=
# The runner renews this lease every third of its duration (at most once a
# minute). It automatically expires after an interrupted run. Default: 600.
# export EPR_LOAD_TEST_LEASE_DURATION_SECONDS=600

# ---- Browser load test
# Maximum randomized delay before each virtual user starts its first journey.
# Milliseconds; defaults to 0. For example, 30000 spreads starts over 30 seconds.
# export LOAD_TEST_USER_START_JITTER_MS=0

# ---- Shared backend credentials (K6 basic-auth + Lighthouse pre-run reset)
export WASTE_OBLIGATION_USERNAME=
export WASTE_OBLIGATION_PASSWORD=

# ---- K6
# Scenario to run, or "all". Path is relative to scenarios/backend/tests/.
export TEST_SCENARIO=all
# export TEST_SCENARIO=get-obligations/baseline.js
# export TEST_SCENARIO=get-obligations/load.js
# export TEST_SCENARIO=get-compliance-declarations/baseline.js
# export TEST_SCENARIO=get-compliance-declarations/load.js
# export TEST_SCENARIO=create-compliance-declaration/baseline.js
# export TEST_SCENARIO=create-compliance-declaration/load.js
# export TEST_SCENARIO=search-compliance-declarations/baseline.js
# export TEST_SCENARIO=search-compliance-declarations/load.js

# DefraID credentials for the UI sign-in.
export EPR_USER_EMAIL=
export EPR_USER_PASSWORD=

# Org whose CSOC declarations are reset (PATCH-to-Cancelled) before the run
# and submitted to during the run.
export EPR_ORG_ID=

# Submitter identity stamped on cancelled records.
export WASTE_OBLIGATION_SUBMITTER_ID=
export WASTE_OBLIGATION_SUBMITTER_EMAIL=

# Optional Lighthouse overrides — frontend URL, backend URL.
# export EPR_BASE_URL=https://localhost:8010
# export EPR_BACKEND_BASE_URL=http://localhost:8007

# For local runs against the ephemeral protected API gateway, set both:
# export EPR_BACKEND_BASE_URL=https://ephemeral-protected.api.perf-test.cdp-int.defra.cloud/waste-obligations
# export X_API_KEY=

# HTTP proxy (format: http://host:port). k6 honours HTTP_PROXY natively;
# Lighthouse forwards it to Chromium.
# export HTTP_PROXY=http://proxy.example.com:8080
# Capture requests accepted by the Azure stub during the workload, then wait up
# to 120 seconds (30 by default) for asynchronous sends before taking a snapshot.
# Requires the MO-654 stub and notification-service perf-test configuration.
export NOTIFICATION_CAPTURE_ENABLED=false
export NOTIFICATION_CAPTURE_WAIT_SECONDS=30
