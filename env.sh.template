#!/bin/sh
# Usage: source ./env.sh
# Copy this file to env.sh and fill in your values

export CI=false
export ENVIRONMENT=perf-test
export WASTE_OBLIGATION_USERNAME=
export WASTE_OBLIGATION_PASSWORD=

# Which runner the entrypoint should use:
#   jmeter (default) — run the .jmx scenarios under scenarios/
#   k6              — delegate entirely to scenarios-k6/entrypoint.sh
#   both            — run JMeter, then K6 (K6 results land in S3 under /k6)
export TEST_RUNNER=jmeter

# TEST_SCENARIO is interpreted by whichever runner is active. Use "all" or
# a path relative to the runner's scenarios folder.
export TEST_SCENARIO=all
# JMeter examples:
# export TEST_SCENARIO=get-compliance-declarations/baseline-test.jmx
# export TEST_SCENARIO=get-compliance-declarations/load-test.jmx
# K6 examples (require TEST_RUNNER=k6):
# export TEST_SCENARIO=get-compliance-declarations/baseline.js
# export TEST_SCENARIO=get-compliance-declarations/load.js

# HTTP proxy configuration for CI (format: host:port or http://host:port)
# export HTTP_PROXY=proxy.example.com:8080
