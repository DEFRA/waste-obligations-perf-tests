#!/bin/sh
# From the repository root: copy this file to env.sh and fill in credentials before ./entrypoint.sh.
# Node and k6 run on your machine; no Azure-stub session or browser credentials are needed.
export CI=false
export ENVIRONMENT=test
export PROFILE=prn-obligations
export TEST_SCENARIO=prn-obligations/sustained.js

export WASTE_ORGANISATIONS_BASE_URL=https://waste-organisations.test.cdp-int.defra.cloud
export WASTE_ORGANISATIONS_AUTH_MODE=oauth2
export WASTE_ORGANISATIONS_TOKEN_URL=
export WASTE_ORGANISATIONS_CLIENT_ID=
export WASTE_ORGANISATIONS_CLIENT_SECRET=
# Optional scopes required by the organisation service's OAuth client/token issuer.
export WASTE_ORGANISATIONS_SCOPE=
# Cognito client credentials normally use HTTP Basic client authentication.
export WASTE_ORGANISATIONS_TOKEN_AUTH_METHOD=basic

# Azure TEST target and scope from the waste-obligations integration configuration.
export PRN_API_BASE_URL=https://tstrwdwebwa1418.azurewebsites.net
export PRN_API_AUTH_MODE=oauth2
export PRN_API_TOKEN_URL=https://login.microsoftonline.com/6f504113-6b64-43f2-ade9-242e05780007/oauth2/v2.0/token
export PRN_API_CLIENT_ID=
export PRN_API_CLIENT_SECRET=
export PRN_API_SCOPE=89d9dba8-b47f-44db-900d-df9a4982b1db/.default
# Matches waste-obligations: URL-encoded client_id, client_secret and scope in the token POST body.
export PRN_API_TOKEN_AUTH_METHOD=body

export PRN_TEST_OBLIGATION_YEAR=2026
export PRN_TEST_REFRESH_WINDOW_SECONDS=1800
export PRN_TEST_DURATION=30m
export PRN_TEST_PREALLOCATED_VUS=5
export PRN_TEST_MAX_VUS=50
export PRN_TEST_REQUEST_TIMEOUT_SECONDS=60
# export PRN_TEST_P95_MS=2000
