#!/bin/sh
# From the repository root: copy this file to env.sh, then ./entrypoint.sh.
# Start waste-organisations (including its seed) and epr-prn-common-backend in epr-local-environment.
export CI=false
export ENVIRONMENT=local
export PROFILE=prn-obligations
export TEST_SCENARIO=prn-obligations/sustained.js

export WASTE_ORGANISATIONS_BASE_URL=http://localhost:8006
export WASTE_ORGANISATIONS_AUTH_MODE=basic
export WASTE_ORGANISATIONS_CLIENT_ID=Developer
export WASTE_ORGANISATIONS_CLIENT_SECRET=developer-pwd

# The real local PRN backend has no Azure authentication gateway.
export PRN_API_BASE_URL=http://localhost:5168
export PRN_API_AUTH_MODE=none

export PRN_TEST_OBLIGATION_YEAR=2026
export PRN_TEST_REFRESH_WINDOW_SECONDS=1800
export PRN_TEST_DURATION=30m
export PRN_TEST_PREALLOCATED_VUS=5
export PRN_TEST_MAX_VUS=50
export PRN_TEST_REQUEST_TIMEOUT_SECONDS=60
# Optional agreed latency threshold. No latency SLA is assumed by default.
# export PRN_TEST_P95_MS=2000
# For a quick functional smoke: use a 60-second refresh window and duration 1m.
# Container runs: use host.docker.internal instead of localhost for host-published ports.
