#!/bin/sh
# Copy to env.sh and fill in your values. The entrypoint sources it.

export CI=false

# Selects the frontend base URL (rwd-{env}.azure.defra.cloud).
# Recognised values: dev, tst1, perf-test. Set EPR_BASE_URL below to override
# directly, e.g. for a CDP review environment.
export ENVIRONMENT=perf-test
# export EPR_BASE_URL=https://rwd-perf-test.azure.defra.cloud

# DefraID credentials (same vars as the journey-tests). Required.
export EPR_USER_EMAIL=
export EPR_USER_PASSWORD=

# Org whose CSOC declarations are reset (PATCH-to-Cancelled) before the run
# and submitted to during the run.
export EPR_ORG_ID=

# Backend basic-auth credentials for the pre-run PATCH-to-Cancelled call and
# the submitter identity stamped on cancelled records. Same vars as the
# journey-tests.
export WASTE_OBLIGATION_USERNAME=
export WASTE_OBLIGATION_PASSWORD=
export WASTE_OBLIGATION_SUBMITTER_ID=
export WASTE_OBLIGATION_SUBMITTER_EMAIL=

# Obligation year to target. Defaults to the current year.
# export EPR_OBLIGATION_YEAR=2026

# Override for the backend host. Defaults to
# waste-obligations.{env}.cdp-int.defra.cloud derived from ENVIRONMENT.
# export EPR_BACKEND_BASE_URL=

# Lighthouse performance score below which the run exits non-zero (0-1 range).
# export PERFORMANCE_FLOOR=0.5

# HTTP proxy (format: http://host:port). Forwarded to Chromium.
# export HTTP_PROXY=http://proxy.example.com:8080
